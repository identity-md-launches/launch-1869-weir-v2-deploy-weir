{
  "name": "weir-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/export.mjs prepare && vite build && node scripts/export.mjs finalize",
    "preview": "vite preview --host 127.0.0.1",
    "check:export": "node scripts/export.mjs check",
    "check:chain": "node scripts/check-chain.mjs",
    "test": "tsx --test tests/domain.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@tanstack/react-query": "^5.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "8.3.4"
  }
}
